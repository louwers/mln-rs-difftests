load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Differential tests: the ported geometry libraries in //vendor (earcut,
# geojson-vt, geojson, supercluster, kdbush, polylabel, cheap-ruler,
# shelf-pack, wagyu, and the libstdc++ algorithms they depend on) against
# the C++ libraries the core vendors. They are header-only, so each
# reference compiles them directly instead of linking @maplibre//:mbgl-core.

rust_library(
    name = "geometry_difftest_support",
    testonly = True,
    srcs = ["support.rs"],
    deps = ["@next_crates//:proptest"],
)

cc_library(
    name = "libstdcxx_reference",
    srcs = ["libstdcxx_reference.cpp"],
    copts = ["-std=c++20"],
)

rust_test(
    name = "libstdcxx_difftest",
    # The comparison is pinned to the Linux oracle (libstdc++ order, glibc
    # libm, FMA contraction): the C++ itself behaves differently on macOS.
    target_compatible_with = ["@platforms//os:linux"],
    size = "medium",
    srcs = ["libstdcxx_difftest.rs"],
    link_deps = [":libstdcxx_reference"],
    deps = [
        ":geometry_difftest_support",
        "@next_crates//:mln-rs-libstdcxx",
        "@next_crates//:proptest",
    ],
)

cc_library(
    name = "earcut_reference",
    srcs = ["earcut_reference.cpp"],
    copts = ["-std=c++20"],
    deps = [
        "@maplibre//vendor:earcut.hpp",
        "@maplibre//vendor:maplibre-native-base",
    ],
)

rust_test(
    name = "earcut_difftest",
    # The generated polygons hit float differences in the arm64 C++ (FMA
    # contraction), so the comparison is pinned to the Linux oracle;
    # earcut_fixtures_difftest stays cross-platform.
    target_compatible_with = ["@platforms//os:linux"],
    size = "medium",
    srcs = ["earcut_difftest.rs"],
    link_deps = [":earcut_reference"],
    deps = [
        ":geometry_difftest_support",
        "@next_crates//:mln-rs-earcut",
        "@next_crates//:mln-rs-geometry",
        "@next_crates//:proptest",
    ],
)

rust_test(
    name = "earcut_fixtures_difftest",
    size = "medium",
    srcs = ["earcut_fixtures_difftest.rs"],
    data = ["@maplibre//vendor:earcut_fixtures"],
    link_deps = [":earcut_reference"],
    deps = [
        "@next_crates//:mln-rs-earcut",
        "@next_crates//:mln-rs-earcut-test-fixtures",
        "@next_crates//:mln-rs-geometry",
    ],
)

cc_library(
    name = "geojson_reference",
    srcs = ["geojson_reference.cpp"],
    hdrs = ["canonical.hpp"],
    copts = ["-std=c++20"],
    deps = [
        "@maplibre//vendor:maplibre-native-base",
        "@maplibre//vendor:rapidjson",
    ],
)

