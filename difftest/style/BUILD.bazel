load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_rust//rust:defs.bzl", "rust_test")
load("//difftest/sqlite:defs.bzl", "ORACLE_SQLITE")

# Differential tests: //crates/mln_style against the C++ core (style parser,
# background-layer paint properties, transitions).

cc_library(
    name = "reference",
    srcs = [
        "platform_shims.cpp",
        "reference.cpp",
    ],
    copts = [
        "-std=c++20",
        "-fexceptions",
        "-fno-rtti",
        "-Wno-deprecated-declarations",
    ],
    # platform_shims.cpp defines symbols that mbgl-core needs; linked as a whole
    # archive they resolve regardless of archive order (C++ link action).
    alwayslink = True,
    deps = ["@maplibre//:mbgl-core"],
)

rust_test(
    name = "style_difftest",
    # The comparison is pinned to the Linux oracle (glibc libm/strtod,
    # libstdc++ hashing, x86-64 conversions, FMA contraction): the C++
    # itself behaves differently on macOS/arm64.
    target_compatible_with = ["@platforms//os:linux"],
    size = "medium",
    srcs = ["style_difftest.rs"],
    data = ["@maplibre//metrics:render-test-files"],
    link_deps = ORACLE_SQLITE + [":reference"],
    deps = [
        "@next_crates//:mln-rs-style",
        "@next_crates//:mln-rs-style-types",
        "@next_crates//:mln-rs-util",
        "@next_crates//:proptest",
    ],
)
