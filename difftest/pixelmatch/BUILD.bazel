load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_rust//rust:defs.bzl", "rust_test")

# The C++ pixelmatch is header-only: compiled here directly instead of
# depending on @maplibre//:mbgl-core.
cc_library(
    name = "reference",
    srcs = ["reference.cpp"],
    copts = ["-std=c++20"],
    deps = ["@maplibre//vendor:maplibre-native-base"],
)

rust_test(
    name = "pixelmatch_difftest",
    # The comparison is pinned to the Linux oracle (libstdc++ order, glibc
    # libm, FMA contraction): the C++ itself behaves differently on macOS.
    target_compatible_with = ["@platforms//os:linux"],
    srcs = ["pixelmatch_difftest.rs"],
    link_deps = [":reference"],
    deps = [
        "@next_crates//:mln-rs-pixelmatch",
        "@next_crates//:proptest",
    ],
)
